# ================================================================
# AkÄ±llÄ± Kira YÃ¶netim Sistemi â€” Environment DeÄŸiÅŸkenleri
# .env.example dosyasÄ±nÄ± kopyalayÄ±p .env olarak kaydedin
# ================================================================

# PostgreSQL (User, Report, Saga DB'leri)
POSTGRES_USER=rentadmin
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
POSTGRES_DB=rent_management

# SQL Server (Lease, Payment DB'leri)
SA_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
MSSQL_PID=Developer

# MongoDB (Property, Maintenance, Notification, Document)
MONGO_INITDB_ROOT_USERNAME=rentadmin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET

# Redis
REDIS_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
KC_DB_USERNAME=rentadmin
KC_DB_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET
# Optional local-demo user passwords; use a different secret for each role.
KEYCLOAK_DEMO_ADMIN_PASSWORD=
KEYCLOAK_DEMO_LANDLORD_PASSWORD=
KEYCLOAK_DEMO_TENANT_PASSWORD=

# MinIO
MINIO_ROOT_USER=rentadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET

# Kafka
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092

# Seq (Structured Logging)
SEQ_API_KEY=REPLACE_WITH_A_UNIQUE_SECRET

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET

# Servis PortlarÄ±
GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
PROPERTY_SERVICE_PORT=5002
LEASE_SERVICE_PORT=5003
PAYMENT_SERVICE_PORT=5004
MAINTENANCE_SERVICE_PORT=5005
NOTIFICATION_SERVICE_PORT=5006
DOCUMENT_SERVICE_PORT=5007
REPORT_SERVICE_PORT=5008
SAGA_ORCHESTRATOR_PORT=5009
# RabbitMQ app credentials (remote clients cannot use the built-in guest account)
RABBITMQ_DEFAULT_USER=rentflow
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_A_UNIQUE_SECRET
