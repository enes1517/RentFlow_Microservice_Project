{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "RequireHttpsMetadata": true
  },
  "ReverseProxy": {
    "Routes": {
      "property-route": {
        "ClusterId": "property-cluster",
        "Match": {
          "Path": "/api/properties/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "lease-route": {
        "ClusterId": "lease-cluster",
        "Match": {
          "Path": "/api/leases/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/maintenancerequests/{**catch-all}"
        }
      },
      "document-route": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "report-route": {
        "ClusterId": "report-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "saga-route": {
        "ClusterId": "saga-cluster",
        "Match": {
          "Path": "/api/sagas/{**catch-all}"
        }
      },
      "property-swagger-route": {
        "ClusterId": "property-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/property/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "user-swagger-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/user/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "lease-swagger-route": {
        "ClusterId": "lease-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/lease/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "payment-swagger-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "maintenance-swagger-route": {
        "ClusterId": "maintenance-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/maintenance/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "document-swagger-route": {
        "ClusterId": "document-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/document/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "notification-swagger-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "report-swagger-route": {
        "ClusterId": "report-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/report/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "saga-swagger-route": {
        "ClusterId": "saga-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/swagger/saga/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "property-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://propertyservice:80"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userservice:80"
          }
        }
      },
      "lease-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://leaseservice:80"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://paymentservice:80"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://maintenanceservice:80"
          }
        }
      },
      "document-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://documentservice:80"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notificationservice:80"
          }
        }
      },
      "report-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reportservice:80"
          }
        }
      },
      "saga-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://sagaorchestrator:80"
          }
        }
      }
    }
  }
}
